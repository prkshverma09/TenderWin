# =============================================================================
# TenderWin – environment variables (copy to .env and fill in)
# =============================================================================
# Do not commit .env. This file is a template only.

# -----------------------------------------------------------------------------
# MCP Gateway (apps/mcp-gateway)
# -----------------------------------------------------------------------------
# Port for the HTTP gateway that exposes SharePoint and Salesforce MCP servers.
# Optional; default is 3100.
# MCP_GATEWAY_PORT=3100

# -----------------------------------------------------------------------------
# Teams Bot (apps/teams-bot)
# -----------------------------------------------------------------------------
# Port for the Restify server (e.g. /api/handoff).
# Optional; default is 3978.
# PORT=3978

# -----------------------------------------------------------------------------
# Word Add-in + Airia (apps/word-addin) – for E2E with Airia
# -----------------------------------------------------------------------------
# Only needed when wiring the add-in to the Airia API. Use VITE_ prefix so
# Vite exposes them to the client (do not put secrets in client if avoidable).
#
# Base URL for the Airia API (from Airia API docs).
# VITE_AIRIA_API_URL=https://api.airia.ai
#
# API key for invoking your TenderWin agent. Prefer a backend proxy and use
# VITE_AIRIA_PROXY_URL instead so the key is never in the client.
# VITE_AIRIA_API_KEY=your_api_key_here
#
# Your TenderWin agent ID from the Airia dashboard.
# VITE_AIRIA_AGENT_ID=your_agent_id_here
#
# If you use a backend proxy that holds the API key, set only this:
# VITE_AIRIA_PROXY_URL=https://your-proxy.example.com/airia
#
# Optional (used by airia-proxy when running e2e:real-airia): if Airia uses Bearer auth or a different path:
# AIRIA_AUTH_TYPE=Bearer
# AIRIA_INVOKE_PATH=/v1/agents/run/{agentId}
