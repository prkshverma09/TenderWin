{
  "name": "tenderwin-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "mcp:gateway": "npm run build --workspace=@tenderwin/mcp-sharepoint --workspace=@tenderwin/mcp-salesforce && npm run start --workspace=@tenderwin/mcp-gateway",
    "mcp:gateway:dev": "npm run build --workspace=@tenderwin/mcp-sharepoint --workspace=@tenderwin/mcp-salesforce && npm run dev --workspace=@tenderwin/mcp-gateway",
    "addin:setup-env": "bash scripts/setup-addin-env.sh",
    "addin:check-env": "node scripts/check-addin-env.js",
    "dev:addin": "npm run dev --workspace=@tenderwin/word-addin",
    "dev:airia-proxy": "npm run dev --workspace=@tenderwin/airia-proxy",
    "e2e": "npm run test --workspace=@tenderwin/e2e-tests --",
    "e2e:real-airia": "bash scripts/e2e-real-airia.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0"
  }
}